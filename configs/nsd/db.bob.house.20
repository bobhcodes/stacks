$ORIGIN bob.house.
$TTL 7200

; SOA

@       IN      SOA    docker2.bob.house. hostmaster.bob.house. (
                                         2026090200 ; Serial
                                         7200       ; Refresh
                                         1800       ; Retry
                                         1209600    ; Expire
                                         86400 )    ; Minimum

; NAMESERVERS

@                   IN        NS                   docker2.bob.house.

